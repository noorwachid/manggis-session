(
	workspaces: [

		( id: "1" ),
		( id: "2" ),
		( id: "3" ),
		( id: "4" ),
		( id: "5", port: "HDMI-2" ),

	],

	bindings: {

		"alt + drag":         ( moveWindow: null ),
		"alt + shift + drag": ( resizeWindow: null ),

		"alt + return": ( exec: ["xterm"] ),
		"alt + space":  ( exec: ["dmenu"] ),

		"alt + left":  ( focusWindow: "west" ),
		"alt + right": ( focusWindow: "east" ),
		"alt + up":    ( focusWindow: "north" ),
		"alt + down":  ( focusWindow: "south" ),

		"alt + shift + left":  ( tileWindow: ( x: 0.0, y: 0.0, width: 0.5, height: 1.0 ) ),
		"alt + shift + right": ( tileWindow: ( x: 0.5, y: 0.0, width: 0.5, height: 1.0 ) ),
		"alt + shift + up":    ( tileWindow: ( x: 0.0, y: 0.0, width: 1.0, height: 1.0 ) ),
		"alt + shift + down":  ( restoreWindow: null ),

		"alt + 1": ( focusWorkspace: "1" ),
		"alt + 2": ( focusWorkspace: "2" ),
		"alt + 3": ( focusWorkspace: "3" ),
		"alt + 4": ( focusWorkspace: "4" ),
		"alt + 5": ( focusWorkspace: "5" ),

		"alt + shift + 1": ( sendWindowToWorkspace: "1" ),
		"alt + shift + 2": ( sendWindowToWorkspace: "2" ),
		"alt + shift + 3": ( sendWindowToWorkspace: "3" ),
		"alt + shift + 4": ( sendWindowToWorkspace: "4" ),
		"alt + shift + 5": ( sendWindowToWorkspace: "5" ),

	},

	autostarts: [
		( exec: ["polybar"] ),
	],

	styles: (
		frame: (
			titlebarHeight: 20,
			borderWidth: 1,

			active: (
				titlebarColor: "#00FFFF",
				borderColor: "#2288FF",
			),

			inactive: (
				titlebarColor: "#00FFFF",
				borderColor: "#2288FF",
			),
		)
	),
)
